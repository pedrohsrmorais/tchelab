# TcheLab — variáveis usadas pelo docker-compose.yml (via ${VAR}).
# Copie para `.env` na raiz do repo e preencha com valores reais:
#   cp .env.example .env
#
# Este arquivo nunca deve conter segredos reais — `.env` já está no
# .gitignore da raiz (regra `.env` sem caminho, cobre qualquer profundidade).

# --- MySQL -------------------------------------------------------------
# Senha do usuário root do MySQL (só usada internamente pelo container/healthcheck).
DB_ROOT_PASSWORD=troque_esta_senha_root

# Credenciais da aplicação (iguais às já usadas pelo backend_api hoje).
DB_USER=tchelab
DB_PASSWORD=troque_esta_senha
DB_NAME=tchelab

# --- JWT -----------------------------------------------------------------
# Gere valores únicos e longos, ex: `openssl rand -hex 32`
JWT_SECRET=troque_este_segredo_jwt
JWT_REFRESH_SECRET=troque_este_segredo_refresh

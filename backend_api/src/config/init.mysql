('12344729-9593-4f91-adef-db0e41b5e6da','Tucker Regression','tucker_regression','multiway_regression','regression','08_multiway_regression','Regressão via decomposição Tucker: scores → regressão linear.',1,0),
('51f0c172-72d1-4926-b0f2-98fba8d98444','U-PCA — Unfolded PCA','u_pca','multiway_regression','regression','08_multiway_regression','PCA sobre tensor desdobrado (análise exploratória multiway).',1,0),
('d3cdd8a4-91af-404c-aabc-7c8e539173b5','Wavelet Transform','wavelet_transform','preprocessing','other','02_preprocessamento','Decomposição Wavelet discreta para suavização, decomposição ou extração de features.',1,0);

-- =============================================================================
-- SEED: técnica Kennard-Stone (schema completo — sobrescreve a versão thin
-- inserida no sync acima via ON DUPLICATE KEY UPDATE). Mantido idêntico a
-- backend_api/sql/seed_kennard_stone.sql.
-- =============================================================================

-- TcheLab — Registro da técnica "kennard_stone" na tabela `techniques`.
--
-- Por quê este arquivo existe: o repositório não tem nenhum sistema de
-- migração (sem Knex/Sequelize/db-migrate, sem schema.sql versionado — ver
-- `docs/database.md` para o DDL completo, que também não está commitado como
-- .sql). O catálogo Python (worker_api/catalog/) se auto-registra sozinho
-- via ScriptFactory, mas a tabela `techniques` do MySQL — de onde o editor
-- de workflow, o ShapeValidatorService e a listagem /techniques leem os
-- schemas de porta — precisa ser populada manualmente.
--
-- Como aplicar: rode este arquivo contra o banco do ambiente
-- (ex: `mysql -u tchelab -p tchelab < backend_api/sql/seed_kennard_stone.sql`).
-- É seguro rodar mais de uma vez: na primeira vez insere a técnica, nas
-- seguintes apenas atualiza os campos (ON DUPLICATE KEY UPDATE pela `slug`,
-- que é UNIQUE) em vez de pular silenciosamente — então reaplicar também
-- conserta a linha caso ela precise de correção (foi exatamente o caso do
-- `SET NAMES utf8mb4` abaixo: sem ele, rodar este arquivo num cliente mysql
-- com locale não-UTF8 — comum em servidores com LANG=C/POSIX — gravava
-- "Separação" como "SeparaÃ§Ã£o", um double-encoding silencioso só visível
-- consultando com `mysql --default-character-set=utf8mb4`; a primeira versão
-- deste arquivo não tinha essa linha e usava WHERE NOT EXISTS, então uma
-- linha já corrompida nunca seria reescrita por um reaplique).
SET NAMES utf8mb4;

INSERT INTO techniques (
  uuid, slug, name, category, subcategory, family, description,
  input_type, output_type, input_schema, output_schema, parameter_schema,
  min_order, max_order, requires_sample_axis, tags, version,
  is_beta, is_custom, implementation, documentation, active,
  created_at, updated_at
) VALUES (
  UUID(),
  'kennard_stone',
  'Separação Kennard-Stone',
  'validation',
  'sample_split',
  '01_dados',
  'Divide as amostras em calibração (treino), teste e, opcionalmente, validação, selecionando iterativamente a amostra mais distante (distância Euclidiana) das já escolhidas — maximiza a cobertura da variabilidade multivariada em vez de uma divisão aleatória. Determinístico: a mesma entrada sempre produz a mesma divisão.',
  'Matrix',
  'Matrix',
  JSON_OBJECT(
    'X', JSON_OBJECT('type', 'matrix', 'description', 'Amostras × variáveis (sample_axis configurável, aceita N-way)')
  ),
  JSON_OBJECT(
    'train', JSON_OBJECT('type', 'matrix', 'description', 'Subconjunto de calibração/treino'),
    'test', JSON_OBJECT('type', 'matrix', 'description', 'Subconjunto de teste'),
    'validation', JSON_OBJECT('type', 'matrix', 'description', 'Subconjunto de validação (presente apenas quando n_validation/validation_size > 0)'),
    'train_indices', JSON_OBJECT('type', 'vector', 'description', 'Índices originais (em X) do conjunto de treino'),
    'test_indices', JSON_OBJECT('type', 'vector', 'description', 'Índices originais (em X) do conjunto de teste'),
    'validation_indices', JSON_OBJECT('type', 'vector', 'description', 'Índices originais (em X) do conjunto de validação')
  ),
  JSON_OBJECT(
    'sample_axis', JSON_OBJECT('type', 'integer', 'default', 0, 'description', 'Eixo de amostras'),
    'n_train', JSON_OBJECT('type', 'integer', 'description', 'Tamanho absoluto do conjunto de treino (prioridade sobre train_size)'),
    'train_size', JSON_OBJECT('type', 'number', 'default', 0.7, 'range', JSON_ARRAY(0, 1), 'description', 'Fração do total para treino, usada quando n_train não é informado'),
    'n_validation', JSON_OBJECT('type', 'integer', 'description', 'Tamanho absoluto do conjunto de validação (opcional)'),
    'validation_size', JSON_OBJECT('type', 'number', 'default', 0, 'range', JSON_ARRAY(0, 1), 'description', 'Fração do total para validação, usada quando n_validation não é informado')
  ),
  1,
  NULL,
  1,
  JSON_ARRAY('kennard-stone', 'split', 'train-test', 'calibração', 'amostragem', 'validação'),
  '1.0',
  0,
  0,
  'worker_api/catalog/familia_01_dados/scripts.py:KennardStone',
  'Ver docs/catalogo_scripts.md#kennard_stone para o algoritmo completo e exemplos.',
  1,
  NOW(),
  NOW()
)
ON DUPLICATE KEY UPDATE
  name = VALUES(name),
  category = VALUES(category),
  subcategory = VALUES(subcategory),
  family = VALUES(family),
  description = VALUES(description),
  input_type = VALUES(input_type),
  output_type = VALUES(output_type),
  input_schema = VALUES(input_schema),
  output_schema = VALUES(output_schema),
  parameter_schema = VALUES(parameter_schema),
  min_order = VALUES(min_order),
  max_order = VALUES(max_order),
  requires_sample_axis = VALUES(requires_sample_axis),
  tags = VALUES(tags),
  implementation = VALUES(implementation),
  documentation = VALUES(documentation),
  active = VALUES(active),
  updated_at = NOW();

-- =============================================================================
-- LISTA BETA: 75 técnicas ativas (ver backend_api/sql/CATALOG_AUDIT.md §5).
-- Mantido idêntico a backend_api/sql/beta_active_set.sql.
-- =============================================================================

-- =============================================================================
-- Lista beta: 75 técnicas ativas, resto marcado 'em desenvolvimento' (active=0)
-- Decidido em conversa com o usuário em 2026-10-10 — ver backend_api/sql/CATALOG_AUDIT.md
-- Idempotente.
-- =============================================================================

-- `mlp` (MLP único, parametrizado por task=classification/regression) nunca
-- teve linha própria — era um dos 5 pares ambíguos deixados de lado no sync
-- anterior (o banco só tinha `mlp_classification`/`mlp_regression`
-- separados). Insere agora porque o usuário confirmou MLP pra beta.
-- `mlp_classification`/`mlp_regression` ficam como duplicatas inativas
-- (já cobertas pelo active=0 abaixo), documentadas em CATALOG_AUDIT.md.
INSERT IGNORE INTO `techniques` (`uuid`,`name`,`slug`,`category`,`subcategory`,`family`,`description`,`active`,`is_beta`)
VALUES (UUID(), 'MLP — Multi-Layer Perceptron', 'mlp', 'deep_learning', 'mlp', '06_deep_learning', 'Rede neural densa (MLP) para regressão ou classificação.', 1, 0);

UPDATE `techniques` SET `active` = 0 WHERE `is_custom` = 0;

UPDATE `techniques` SET `active` = 1 WHERE `is_custom` = 0 AND `slug` IN ('autoencoder','autoscaling','autovalores','autovetores','baseline','centering','cnn_1d','concatenacao','cross_validation','determinante','diffusion','divisao_elementwise','ds','eig','expand_dims','folding','formula_customizada','hca','importacao','inversa','ipls','kennard_stone','knn','lda','leverage_influence','limpeza','max','mcr_als','mean','median','metrics_aggregation','min','mlp','msc','multiplicacao_elementwise','multiway_pls_da','n_pls','norma','outlier_detection','parafac','pca','pcr','pds','pls','pls_da','pls_oc','produto_matricial','pseudo_inversa','random_forest','rank','reshape','rnn','savitzky_golay','selecao_amostras','selecao_variaveis','simca','slice','snv','soma','split','squeeze','stack','std','subtracao','sum','svd','svm','trace','transformer','transpose','tratamento_missing','tucker3','u_pls','unfolding','vip');

-- =============================================================================
-- Conteúdo do módulo Catálogo: how_it_works, historical_note, usage_tips, e
-- descrição por porta em input_schema/output_schema, para as 75 técnicas
-- ativas da versão beta. Pedido pelo usuário em 2026-10-10 — ver
-- backend_api/sql/CATALOG_AUDIT.md §7 e backend_api/sql/catalog_content_source.py
-- (fonte; gera catalog_content.sql via gen_catalog_content_sql.py). Idempotente.
-- =============================================================================

-- TcheLab — Conteúdo do módulo Catálogo (how_it_works, historical_note,
-- usage_tips) e enriquecimento de input_schema/output_schema com descrição
-- por porta, para as 75 técnicas ativas da versão beta.
--
-- Gerado a partir de backend_api/sql/catalog_content_source.py — não editar
-- este arquivo à mão, regenerar a partir da fonte.
--
-- Idempotente: cada UPDATE sobrescreve os mesmos valores, e
-- JSON_MERGE_PATCH com a chave já presente apenas substitui — rodar
-- de novo não duplica nem acumula.
SET NAMES utf8mb4;

ALTER TABLE techniques
  ADD COLUMN IF NOT EXISTS how_it_works TEXT NULL COMMENT 'Explicação de como o método funciona, pro módulo Catálogo',
  ADD COLUMN IF NOT EXISTS historical_note TEXT NULL COMMENT 'Curiosidade histórica: quem criou, quando, contexto',
  ADD COLUMN IF NOT EXISTS usage_tips TEXT NULL COMMENT 'Orientação prática de uso (ex: pré-requisitos, quando usar)';

UPDATE techniques SET how_it_works = 'Rede neural treinada pra reconstruir sua própria entrada, passando por um "gargalo" central de dimensão bem menor que a entrada — força a rede a aprender uma representação compacta dos dados. O erro de reconstrução de uma amostra nova (quão mal o autoencoder consegue reconstruí-la) é um sinal de quão atípica/anômala ela é.', historical_note = 'A ideia de redes que aprendem a comprimir e reconstruir sua própria entrada remonta aos anos 1980; a versão variacional (geração probabilística, não só compressão) foi formalizada por Kingma e Welling em 2013.', usage_tips = 'Útil pra detecção de anomalias em dados complexos onde PCA linear não captura a estrutura (o autoencoder aprende compressões não-lineares) — e também pra redução de dimensionalidade antes de outro modelo.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados de treino."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Autoencoder treinado."}, "reconstruction_error": {"description": "Erro de reconstrução de cada amostra — valores altos sugerem amostra atípica."}}') WHERE slug = 'autoencoder';
UPDATE techniques SET how_it_works = 'Centra cada variável na própria média e depois divide pelo próprio desvio padrão, deixando todas as variáveis com média 0 e variância 1 (também chamado de padronização Z-score, ou UV-scaling em quimiometria).', usage_tips = 'Essencial antes de qualquer técnica sensível a escala (PCA de dados não-espectrais, KNN, SVM, clustering) quando as variáveis têm unidades ou magnitudes muito diferentes entre si — sem isso, a variável de maior variância numérica domina o modelo mesmo sem ser a mais relevante quimicamente.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados a ser escalada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X": {"description": "Dados centrados na média e escalados pelo desvio padrão — cada coluna com média 0 e variância 1."}}') WHERE slug = 'autoscaling';
UPDATE techniques SET how_it_works = 'Calcula os autovalores de uma matriz quadrada — os escalares λ pros quais existe um vetor v não-nulo tal que A·v = λ·v. Pra matrizes de covariância (como em PCA), os autovalores correspondem à variância capturada em cada direção própria.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Matriz quadrada de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Autovalores da matriz, geralmente ordenados."}}') WHERE slug = 'autovalores';
UPDATE techniques SET how_it_works = 'Calcula os autovetores de uma matriz quadrada — as direções que a matriz apenas escala (sem rotacionar) quando aplicada a elas. Em matrizes de covariância, são as direções principais de variância dos dados.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Matriz quadrada de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Autovetores da matriz, um por coluna."}}') WHERE slug = 'autovetores';
UPDATE techniques SET how_it_works = 'Estima e subtrai a linha de base (deriva lenta e suave do sinal, não relacionada aos picos de interesse) de cada espectro — por ajuste polinomial, ou pelo método "rubberband" (envoltória inferior convexa, como um elástico esticado por baixo do espectro).', usage_tips = 'Necessário sempre que o instrumento ou a amostra introduz deriva de fundo (comum em Raman, por exemplo) — sem corrigir, a linha de base pode dominar a variância capturada por uma PCA, mascarando a informação química real.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros com deriva de linha de base."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X": {"description": "Espectros com a linha de base estimada removida."}}') WHERE slug = 'baseline';
UPDATE techniques SET how_it_works = 'Subtrai de cada variável (coluna) sua própria média, deixando todas centradas em zero — sem alterar a escala/variância, diferente do autoscaling.', usage_tips = 'Pré-requisito matemático da PCA clássica (PCA sem centrar mistura a direção de maior variância com a posição da média, distorcendo os componentes) — a maioria das implementações de PCA já faz isso internamente, mas é bom saber o que está rodando por baixo.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados a ser centrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X": {"description": "Dados com cada coluna centrada em zero (média subtraída)."}}') WHERE slug = 'centering';
UPDATE techniques SET how_it_works = 'Rede neural convolucional adaptada pra sinais 1D (espectros): em vez de olhar o espectro inteiro de uma vez como o MLP faz, aplica filtros pequenos que deslizam ao longo do eixo espectral, aprendendo padrões locais (formas de picos, derivadas) que se repetem em posições diferentes — compartilhando os mesmos pesos em toda a extensão do espectro.', usage_tips = 'Mais indicada que MLP quando há muitos pontos espectrais e padrões locais importam mais que a posição exata — mas exige um conjunto de treino consideravelmente maior pra não fazer overfitting. Teste PLS/PCR antes como baseline.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros (amostras × comprimentos de onda)."}, "y": {"description": "Valor a prever ou rótulo de classe."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Rede CNN-1D treinada."}}') WHERE slug = 'cnn_1d';
UPDATE techniques SET how_it_works = 'Concatena dois ou mais arrays ao longo de um eixo já existente (diferente do stack, que cria um eixo novo) — ex: juntar dois datasets com as mesmas variáveis em um só, empilhando as amostras.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"arrays": {"description": "Lista de arrays a concatenar, compatíveis em todos os eixos exceto o de concatenação."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Array resultante da concatenação."}}') WHERE slug = 'concatenacao';
UPDATE techniques SET how_it_works = 'Divide o conjunto de treino em K partes ("folds"); treina o modelo K vezes, cada vez deixando uma parte de fora pra testar, e agrega o erro de todas as rodadas. Dá uma estimativa mais honesta do erro do modelo em dados novos do que simplesmente olhar o erro no próprio conjunto de treino.', usage_tips = 'Essencial pra escolher hiperparâmetros (ex: número de componentes do PLS) sem usar o conjunto de teste final — usar o erro de treino puro pra essa escolha quase sempre leva a overfitting. Não substitui uma validação externa com dados nunca vistos.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados de treino."}, "y": {"description": "Valor de referência (regressão) ou rótulo (classificação)."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"metrics": {"description": "Métricas agregadas das K rodadas (RMSE/R² pra regressão, acurácia/F1 pra classificação)."}}') WHERE slug = 'cross_validation';
UPDATE techniques SET how_it_works = 'Calcula o determinante de uma matriz quadrada — um escalar que indica, entre outras coisas, se a matriz é invertível (determinante zero = singular, não-invertível).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Matriz quadrada de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Determinante da matriz."}}') WHERE slug = 'determinante';
UPDATE techniques SET how_it_works = 'Modelo generativo que aprende a reverter um processo de adição gradual de ruído: durante o treino, ruído é progressivamente adicionado a espectros reais até virarem ruído puro, e a rede aprende a desfazer esse processo passo a passo — uma vez treinada, pode tanto remover ruído de espectros reais (denoising) quanto gerar espectros sintéticos plausíveis do zero.', historical_note = 'A formulação moderna ("Denoising Diffusion Probabilistic Models") foi proposta por Ho, Jain e Abbeel em 2020, hoje a base de geradores de imagem como Stable Diffusion e DALL-E — aplicação a espectros é uma adaptação bem mais recente.', usage_tips = 'Pensado pra dois usos: limpar ruído de espectros reais, ou gerar dados sintéticos pra aumentar um conjunto de treino pequeno demais. É o modelo mais experimental/pesado do catálogo — espere tempos de treino bem maiores que os demais.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros de treino."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo de difusão treinado."}, "generated_samples": {"description": "Espectros sintéticos gerados pelo modelo (quando aplicável)."}}') WHERE slug = 'diffusion';
UPDATE techniques SET how_it_works = 'Divide elemento a elemento dois arrays de mesmo shape.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Array dividendo."}, "B": {"description": "Array divisor, de shape compatível (sem zeros)."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Resultado de A / B, elemento a elemento."}}') WHERE slug = 'divisao_elementwise';
UPDATE techniques SET how_it_works = 'Direct Standardization: calibra uma matriz de transformação que converte espectros medidos no instrumento B pra parecerem com os do instrumento A (ou do mesmo instrumento em outra data), usando um conjunto pequeno de amostras medidas nos dois — assim um modelo treinado em A pode ser aplicado a dados de B sem recalibrar do zero.', historical_note = 'Proposto por Yongdong Wang e Bruce Kowalski em 1991, um dos primeiros métodos formais de transferência de calibração entre instrumentos.', usage_tips = 'Precisa de um conjunto de amostras "transfer" medidas nos dois instrumentos/condições — quanto mais representativas da faixa de uso real, melhor a transferência. PDS costuma generalizar melhor quando o desvio entre instrumentos varia ao longo do espectro.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X_master": {"description": "Espectros das amostras de transferência medidas no instrumento/condição de referência."}, "X_slave": {"description": "As mesmas amostras medidas no instrumento/condição a ser padronizado."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"transform_matrix": {"description": "Matriz de transformação a ser aplicada em novos espectros do instrumento \\"slave\\"."}}') WHERE slug = 'ds';
UPDATE techniques SET how_it_works = 'Calcula autovalores e autovetores juntos numa única operação — equivalente a rodar `autovalores` e `autovetores` ao mesmo tempo, mais eficiente que separado quando se precisa dos dois.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Matriz quadrada de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"autovalores": {"description": "Autovalores da matriz."}, "autovetores": {"description": "Autovetores correspondentes, um por coluna."}}') WHERE slug = 'eig';
UPDATE techniques SET how_it_works = 'Adiciona um novo eixo de tamanho 1 num array, na posição especificada — operação inversa do squeeze, útil pra compatibilizar shapes antes de outra operação (ex: concatenação, broadcast).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X_exp": {"description": "Array com um eixo a mais, de tamanho 1."}}') WHERE slug = 'expand_dims';
UPDATE techniques SET how_it_works = 'Reorganiza ("dobra") uma matriz 2D de volta num tensor de ordem superior, revertendo uma operação de unfolding anterior — útil depois de processar dados desdobrados (ex: num U-PLS) e precisar voltar à estrutura multiway original pra visualização.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X_unf": {"description": "Matriz 2D a ser reorganizada em tensor."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X": {"description": "Tensor reconstruído, ordem ≥ 3."}}') WHERE slug = 'folding';
UPDATE techniques SET how_it_works = 'Aplica uma expressão matemática definida pelo próprio usuário sobre os dados, avaliada com segurança (via um parser de árvore sintática, não `eval` direto) — útil pra operações pontuais que não têm um nó dedicado no catálogo.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada disponível na expressão."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Resultado da expressão aplicada."}}') WHERE slug = 'formula_customizada';
UPDATE techniques SET how_it_works = 'Agrupa amostras por similaridade de forma hierárquica: começa tratando cada amostra como seu próprio cluster e vai fundindo os dois clusters mais próximos (por alguma métrica de distância, ex: Euclidiana) repetidamente, até sobrar um só. O resultado é um dendrograma — uma árvore que mostra em que distância cada fusão aconteceu.', historical_note = 'O método de linkage mais usado (Ward, 1963) minimiza o aumento de variância dentro dos clusters a cada fusão — é o mais indicado quando os clusters esperados são razoavelmente esféricos e de tamanho parecido.', usage_tips = 'Não exige escolher o número de clusters antes de rodar (diferente do K-Means) — você decide olhando onde cortar o dendrograma. Dados em escalas muito diferentes devem ser normalizados/autoscaled antes, senão a variável de maior escala domina a distância.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz amostras × variáveis. Recomenda-se autoscaling prévio se as variáveis tiverem escalas muito diferentes."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"linkage_matrix": {"description": "Matriz de ligação (formato scipy) descrevendo cada fusão de clusters."}, "dendrogram_data": {"description": "Coordenadas prontas pra desenhar o dendrograma (icoord/dcoord/leaves/cores)."}}') WHERE slug = 'hca';
UPDATE techniques SET how_it_works = 'Lê um arquivo de dados externo (CSV, Excel, NumPy, HDF5, Zarr) e retorna um dataset pronto pra uso no workflow — é tipicamente o primeiro nó de qualquer pipeline.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"file": {"description": "Caminho ou referência ao arquivo a importar."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X": {"description": "Dados importados, já como matriz/tensor."}}') WHERE slug = 'importacao';
UPDATE techniques SET how_it_works = 'Calcula a matriz inversa A⁻¹, tal que A·A⁻¹ = identidade. Só existe pra matrizes quadradas não-singulares (determinante ≠ 0).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Matriz quadrada e não-singular."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"A_inv": {"description": "Matriz inversa de A."}}') WHERE slug = 'inversa';
UPDATE techniques SET how_it_works = 'Interval PLS: divide o espectro em vários intervalos (janelas) de comprimento de onda e treina um PLS separado em cada intervalo, comparando o erro de validação de cada um — os intervalos com melhor desempenho isolado são os que carregam a informação química mais relevante pra propriedade de interesse.', historical_note = 'Proposto por Lars Nørgaard e colaboradores em 2000, como alternativa interpretável à seleção de variáveis ponto a ponto.', usage_tips = 'Bom primeiro passo de seleção de variáveis quando você quer uma resposta interpretável ("essa faixa espectral é a que importa") em vez de um subconjunto disperso de pontos individuais, como dá o VIP ou o CARS.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros."}, "y": {"description": "Valor de referência a ser previsto."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"best_interval": {"description": "Intervalo espectral com menor erro de validação cruzada."}, "interval_errors": {"description": "Erro de validação cruzada de cada intervalo testado."}}') WHERE slug = 'ipls';
UPDATE techniques SET how_it_works = 'Seleciona iterativamente a amostra mais distante (distância Euclidiana) das já escolhidas, começando pelas duas amostras mais distantes entre si — garante que o conjunto de calibração cubra toda a variabilidade multivariada presente nos dados, em vez de uma divisão aleatória que pode deixar regiões do espaço de amostras mal representadas.', historical_note = 'Proposto por R.W. Kennard e L.A. Stone em 1969 como método de desenho de experimentos ("Computer Aided Design of Experiments"); hoje é o método padrão em quimiometria para dividir dados em treino/teste/validação antes de uma calibração multivariada.' WHERE slug = 'kennard_stone';
UPDATE techniques SET how_it_works = 'Classifica uma amostra nova olhando as K amostras de treino mais próximas dela (por alguma distância, geralmente Euclidiana) e atribuindo a classe majoritária entre essas K vizinhas. Não existe "treino" de verdade — o modelo é só o conjunto de treino guardado.', usage_tips = 'Simples e sem suposições sobre a forma da fronteira entre classes, mas sofre em alta dimensão (muitas variáveis espectrais) se não reduzir dimensionalidade antes (ex: usar os scores de uma PCA em vez do espectro bruto). Sensível à escala — normalize antes.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de variáveis preditoras de treino."}, "y": {"description": "Rótulo de classe de cada amostra de treino."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo KNN (guarda o conjunto de treino e o valor de K)."}}') WHERE slug = 'knn';
UPDATE techniques SET how_it_works = 'Linear Discriminant Analysis: encontra a combinação linear das variáveis que melhor separa as classes conhecidas, maximizando a distância entre as médias das classes relativa à dispersão dentro de cada classe. Assume que as classes têm a mesma matriz de covariância (fronteiras de decisão lineares).', historical_note = 'Proposto por Ronald Fisher em 1936 ("discriminante linear de Fisher") — um dos métodos de classificação mais antigos da estatística, ainda hoje usado como baseline.', usage_tips = 'Baseline clássico pra comparar com PLS-DA: mais simples e interpretável, mas assume que o número de amostras é bem maior que o de variáveis (o que raramente é o caso em espectroscopia crua) — por isso, aplique sobre scores de PCA, não sobre o espectro bruto.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de variáveis preditoras (idealmente scores de PCA, não espectro bruto, se houver mais variáveis que amostras)."}, "y": {"description": "Rótulo de classe de cada amostra."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo LDA treinado."}}') WHERE slug = 'lda';
UPDATE techniques SET how_it_works = 'Calcula, pra cada amostra de um modelo (PCA ou PLS) já treinado, duas medidas diagnósticas: leverage (hat matrix — o quanto a amostra influencia a própria estrutura do modelo, por estar "longe" no espaço dos componentes) e resíduo (o quão mal o modelo explica aquela amostra). Amostras com leverage e resíduo altos são as mais suspeitas de serem outliers influentes.', usage_tips = 'Complementa a Detecção de Outliers: enquanto outlier_detection foca na distância da amostra à distribuição geral, leverage/influência foca especificamente em quanto cada amostra pesa na formação do próprio modelo — rode depois de treinar PCA ou PLS pra auditar se alguma amostra está distorcendo o modelo sozinha.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"model": {"description": "Modelo PCA ou PLS já treinado."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"leverage": {"description": "Leverage de cada amostra (influência na estrutura do modelo)."}, "residuals": {"description": "Resíduo de cada amostra (quão mal o modelo a explica)."}}') WHERE slug = 'leverage_influence';
UPDATE techniques SET how_it_works = 'Remove amostras ou variáveis problemáticas de um dataset: linhas/colunas inteiras de NaN, valores infinitos, ou variáveis com variância zero (que não carregam informação nenhuma).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados a limpar."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X_clean": {"description": "Dados limpos, sem as amostras/variáveis problemáticas."}}') WHERE slug = 'limpeza';
UPDATE techniques SET how_it_works = 'Retorna o valor máximo de um array, ao longo do eixo especificado.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Valor(es) máximo(s) encontrado(s)."}}') WHERE slug = 'max';
UPDATE techniques SET how_it_works = 'Multivariate Curve Resolution — Alternating Least Squares: decompõe um conjunto de misturas (ex: espectros de reações químicas ao longo do tempo) nos espectros puros dos componentes individuais e seus perfis de concentração, sem precisar saber de antemão quais são esses componentes — alterna entre estimar concentrações e estimar espectros até convergir, sob restrições como não-negatividade.', historical_note = 'O algoritmo ALS pra MCR foi desenvolvido por Romà Tauler e Anna de Juan ao longo dos anos 1990, consolidando trabalho anterior de resolução de curvas que remonta a Lawton e Sylvestre (1971).', usage_tips = 'A técnica clássica pra decompor misturas químicas desconhecidas em seus componentes puros — muito usada em monitoramento de reações e análise de misturas sem padrões de referência disponíveis. Resultado depende de boas restrições (não-negatividade, unimodalidade) pra convergir numa solução quimicamente sensata.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de misturas (ex: espectros ao longo do tempo de uma reação) — amostras/tempo × comprimento de onda."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"concentrations": {"description": "Perfil de concentração estimado de cada componente puro ao longo das amostras/tempo."}, "pure_spectra": {"description": "Espectro puro estimado de cada componente."}}') WHERE slug = 'mcr_als';
UPDATE techniques SET how_it_works = 'Calcula a média dos valores de um array, ao longo do eixo especificado (ou do array todo).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Média calculada (escalar ou vetor, conforme o eixo)."}}') WHERE slug = 'mean';
UPDATE techniques SET how_it_works = 'Calcula a mediana dos valores de um array, ao longo do eixo especificado — mais robusta a outliers do que a média.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Mediana calculada."}}') WHERE slug = 'median';
UPDATE techniques SET how_it_works = 'Consolida as métricas de desempenho de várias execuções (ex: diferentes modelos testados no mesmo dataset, ou o mesmo modelo em diferentes datasets) numa única tabela comparativa, facilitando decidir qual configuração performou melhor.', usage_tips = 'Use ao final de uma bateria de testes (ex: comparando PLS com 3, 5 e 10 componentes) em vez de ficar comparando números espalhados manualmente entre execuções separadas.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"execution_ids": {"description": "Lista de execuções/jobs cujas métricas serão agregadas."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"comparison_table": {"description": "Tabela com as métricas lado a lado de cada execução."}}') WHERE slug = 'metrics_aggregation';
UPDATE techniques SET how_it_works = 'Retorna o valor mínimo de um array, ao longo do eixo especificado.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Valor(es) mínimo(s) encontrado(s)."}}') WHERE slug = 'min';
UPDATE techniques SET how_it_works = 'Rede neural densa clássica: camadas de neurônios totalmente conectadas, cada uma aplicando uma transformação linear seguida de uma não-linearidade (ex: ReLU). Treinada por retropropagação do erro (backpropagation) pra minimizar o erro de predição, seja em regressão ou classificação (controlado pelo parâmetro `task`).', historical_note = 'A base teórica (perceptron) é de Frank Rosenblatt (1958); a versão multicamada com backpropagation eficiente que a tornou treinável na prática veio com os trabalhos de Rumelhart, Hinton e Williams em 1986.', usage_tips = 'Precisa de bem mais amostras de treino que PLS/PCR pra generalizar bem, e é mais sensível a overfitting — considere PLS primeiro como baseline e só suba pra MLP se a relação entre X e y for claramente não-linear.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de variáveis preditoras."}, "y": {"description": "Valor a prever (regressão) ou rótulo de classe (classificação), conforme parâmetro `task`."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Rede MLP treinada."}}') WHERE slug = 'mlp';
UPDATE techniques SET how_it_works = 'Multiplicative Scatter Correction: regride cada espectro individual contra um espectro de referência (geralmente a média de todas as amostras) e usa os coeficientes dessa regressão (inclinação e intercepto) pra corrigir o efeito multiplicativo/aditivo de espalhamento.', historical_note = 'Desenvolvido por Paul Geladi, Hans Martens e Tormod Næs em 1985, praticamente ao mesmo tempo em que o campo da quimiometria NIR se consolidava.', usage_tips = 'Alternativa ao SNV com resultado quase sempre equivalente — a diferença é que MSC depende de um espectro de referência (calculado a partir do próprio conjunto de treino), então precisa guardar essa referência pra aplicar em dados novos depois.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros brutos."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X": {"description": "Espectros corrigidos, mesma dimensão da entrada."}}') WHERE slug = 'msc';
UPDATE techniques SET how_it_works = 'Multiplica elemento a elemento dois arrays de mesmo shape (produto de Hadamard — diferente do produto matricial).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Primeiro array."}, "B": {"description": "Segundo array, de shape compatível."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Resultado de A ⊙ B, elemento a elemento."}}') WHERE slug = 'multiplicacao_elementwise';
UPDATE techniques SET how_it_works = 'Versão do PLS-DA aplicada a dados desdobrados (unfolded) de ordem superior — classifica amostras cujo dado bruto é um tensor (ex: imagem hiperespectral, EEM de fluorescência) desdobrando-o em matriz antes de rodar a discriminação.', usage_tips = 'Caminho mais direto pra classificar a partir de dados multiway sem perder tempo construindo um modelo multilinear completo primeiro — bom ponto de partida antes de tentar algo mais sofisticado como PARAFAC-SIMCA.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Tensor de dados, será desdobrado internamente."}, "y": {"description": "Rótulo de classe de cada amostra."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo PLS-DA treinado sobre os dados desdobrados."}}') WHERE slug = 'multiway_pls_da';
UPDATE techniques SET how_it_works = 'Generalização do PLS pra dados de ordem superior (tensores, não só matrizes) — em vez de desdobrar o tensor em uma matriz antes de rodar PLS comum, decompõe X e y simultaneamente preservando a estrutura multilinear original (ex: amostra × comprimento de onda de excitação × emissão, no caso de fluorescência EEM).', historical_note = 'Proposto por Rasmus Bro em 1996, estendendo o PLS pra dados multiway mantendo a interpretabilidade por modo que se perde ao simplesmente desdobrar o tensor.', usage_tips = 'Preferível ao U-PLS (desdobrado) quando a estrutura multilinear dos dados é significativa quimicamente (ex: cada modo representa algo fisicamente distinto, como excitação vs. emissão) — preserva mais informação estrutural do que simplesmente achatar o tensor.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Tensor de dados, ordem ≥ 3 (ex: amostras × excitação × emissão)."}, "y": {"description": "Valor de referência a ser previsto, um por amostra."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo N-PLS treinado."}}') WHERE slug = 'n_pls';
UPDATE techniques SET how_it_works = 'Calcula a norma de um vetor ou matriz (magnitude), conforme o tipo escolhido (L1, L2/Euclidiana, infinito, Frobenius).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Vetor ou matriz de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Valor da norma calculada."}}') WHERE slug = 'norma';
UPDATE techniques SET how_it_works = 'Identifica amostras anômalas de três formas possíveis: distância de Mahalanobis/Hotelling T² (quão longe a amostra está do centro da distribuição, considerando a correlação entre variáveis), ou Isolation Forest (quão fácil é isolar a amostra numa árvore de decisão aleatória — amostras atípicas se isolam com poucos cortes).', usage_tips = 'Rode logo depois da PCA exploratória, antes de treinar qualquer modelo supervisionado — amostras com erro de medição grosseiro ou contaminação distorcem o modelo se entrarem no treino sem serem identificadas antes.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados (idealmente já os scores de uma PCA, não o espectro bruto)."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"outlier_mask": {"description": "Máscara booleana marcando quais amostras são consideradas outliers."}, "scores_": {"description": "Score de anomalia de cada amostra (maior = mais atípica)."}}') WHERE slug = 'outlier_detection';
UPDATE techniques SET how_it_works = 'Decompõe um tensor de ordem 3 (ou mais) numa soma de componentes trilineares — cada componente é o produto externo de um vetor por modo (ex: perfil de concentração, espectro de excitação, espectro de emissão) — análogo multiway da PCA, mas com a vantagem de ter solução única sob condições brandas (ao contrário da PCA/Tucker, que têm ambiguidade de rotação).', historical_note = 'Proposto independentemente por Richard Harshman (1970, como "PARAFAC") e J. Douglas Carroll & Jih-Jie Chang (1970, como "CANDECOMP") — são o mesmo método, hoje chamado de CP decomposition (CANDECOMP/PARAFAC) na literatura mais recente.', usage_tips = 'É a técnica de referência pra decompor dados de fluorescência EEM (matriz excitação-emissão) em seus componentes químicos puros, sem precisar de calibração prévia — a unicidade da solução é o que torna isso possível.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Tensor de ordem ≥ 3 (ex: amostras × excitação × emissão, em fluorescência)."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"scores": {"description": "Perfil de cada amostra em cada componente — shape (amostras, componentes)."}, "loadings": {"description": "Perfis por modo (ex: espectros de excitação e emissão puros de cada componente)."}, "core_consistency": {"description": "Diagnóstico (0-100) de quão apropriado é o número de componentes escolhido — valores baixos sugerem componentes demais."}}') WHERE slug = 'parafac';
UPDATE techniques SET how_it_works = 'Decompõe a matriz X (amostras × variáveis) em um pequeno número de componentes principais — combinações lineares das variáveis originais, ortogonais entre si, ordenadas pela quantidade de variância que capturam. Calculado por SVD. O resultado são os scores (posição de cada amostra nos novos eixos) e os loadings (peso de cada variável original em cada componente).', historical_note = 'Proposto por Karl Pearson em 1901 como um ajuste geométrico de linhas e planos aos dados, e formalizado em termos estatísticos por Harold Hotelling em 1933. É a técnica mais usada em quimiometria para explorar dados multivariados antes de qualquer modelagem.', usage_tips = 'É quase sempre o primeiro passo de qualquer análise exploratória: usa pra ver agrupamentos, tendências e outliers antes de partir pra um modelo supervisionado. Muitas outras técnicas do catálogo (SIMCA, Leverage/Influência, MCR-ALS) dependem de rodar uma PCA antes.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados, amostras nas linhas e variáveis (ex: comprimentos de onda) nas colunas. Recomenda-se já ter passado por algum pré-processamento (SNV/MSC/baseline) se forem espectros."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"scores": {"description": "Coordenadas de cada amostra nos componentes principais — shape (amostras, componentes)."}, "loadings": {"description": "Peso de cada variável original em cada componente — shape (variáveis, componentes)."}, "explained_variance": {"description": "Fração da variância total explicada por cada componente, em ordem decrescente."}}') WHERE slug = 'pca';
UPDATE techniques SET how_it_works = 'Regressão por Componentes Principais: primeiro roda uma PCA em X (sem olhar pra y), depois regride y linearmente sobre os scores desses componentes. Diferente do PLS, a escolha dos componentes não leva em conta a relação com y — só a variância de X.', usage_tips = 'É o contraponto clássico pra comparar com PLS: em geral o PLS precisa de menos componentes pra atingir o mesmo erro, porque já otimiza pensando em y desde o início — mas PCR pode ser mais robusto quando y é ruidoso, já que a etapa de PCA é cega a esse ruído.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de variáveis preditoras."}, "y": {"description": "Valor de referência a ser previsto."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo PCR treinado (PCA + regressão linear sobre os scores)."}}') WHERE slug = 'pcr';
UPDATE techniques SET how_it_works = 'Piecewise Direct Standardization: variante local do DS — em vez de uma transformação global, calibra uma transformação diferente pra cada pequena janela de comprimentos de onda, usando os pontos vizinhos. Lida melhor com desvios entre instrumentos que variam ao longo do espectro.', historical_note = 'Proposto por Elaine Wang, Yongdong Wang e Bruce Kowalski em 1992, como refinamento do DS original.', usage_tips = 'Geralmente a escolha padrão sobre DS puro, especialmente quando o desvio entre instrumentos não é uniforme no espectro inteiro — exige um pouco mais de amostras de transferência pra calibrar bem cada janela.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X_master": {"description": "Espectros das amostras de transferência no instrumento de referência."}, "X_slave": {"description": "As mesmas amostras no instrumento a ser padronizado."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"transform_matrix": {"description": "Transformação local (banda-a-banda) a ser aplicada em novos espectros."}}') WHERE slug = 'pds';
UPDATE techniques SET how_it_works = 'Regressão supervisionada que, ao contrário do PCR, escolhe os componentes (variáveis latentes) olhando simultaneamente pra X e pra y — maximiza a covariância entre eles em vez de só a variância de X. Isso costuma dar modelos mais parcimoniosos (menos componentes) quando a propriedade de interesse realmente se relaciona com a estrutura espectral.', historical_note = 'Desenvolvido por Herman Wold no fim dos anos 1960/70 (econometria) e adaptado pra química por seu filho Svante Wold e Harald Martens no início dos anos 1980 — se tornou o método padrão de calibração multivariada em NIR/quimiometria desde então.', usage_tips = 'É o método de regressão mais usado quando as variáveis preditoras (ex: espectro) são muitas e correlacionadas entre si. Escolha o número de componentes por validação cruzada, não visualmente — mais componentes nem sempre é melhor (overfitting).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros/variáveis preditoras (amostras × variáveis)."}, "y": {"description": "Valor de referência contínuo a ser previsto, uma linha por amostra (ex: concentração medida por método de referência)."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo PLS treinado, pronto pra prever y em novas amostras."}, "scores": {"description": "Projeção das amostras de treino no espaço latente do modelo."}}') WHERE slug = 'pls';
UPDATE techniques SET how_it_works = 'Mesma ideia do PLS, mas usado pra classificação: a variável y vira uma codificação binária/dummy das classes (1 se pertence à classe, 0 se não), e o PLS aprende a separar essas classes no espaço latente. A predição de uma amostra nova é um valor contínuo que se compara a um limiar (threshold) pra decidir a classe.', usage_tips = 'Boa escolha quando as classes não são linearmente separáveis de forma óbvia mas o número de variáveis é grande (típico em espectroscopia). Pra detecção de novidade/outlier de classe ("será que essa amostra nem pertence a nenhuma classe conhecida?") SIMCA costuma ser mais apropriado que PLS-DA.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros/variáveis preditoras."}, "y": {"description": "Rótulo de classe de cada amostra (categórica, codificada internamente como dummy)."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo PLS-DA treinado."}}') WHERE slug = 'pls_da';
UPDATE techniques SET how_it_works = 'Variante one-class do PLS: em vez de discriminar entre classes conhecidas, modela só a classe-alvo e gera pseudo-amostras negativas aleatórias (fora da região da classe) pra calibrar um limiar de decisão — "essa amostra pertence à classe-alvo ou não?".', usage_tips = 'Útil quando você só tem amostras confiáveis de UMA classe (ex: só tem o produto "bom", não tem exemplos rotulados de todos os jeitos de ser "ruim"). Nesse cenário é mais indicado que PLS-DA, que precisa de exemplos de todas as classes.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Espectros da classe-alvo (treino)."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo one-class treinado."}, "threshold": {"description": "Limiar de decisão calibrado contra os pseudo-negativos."}}') WHERE slug = 'pls_oc';
UPDATE techniques SET how_it_works = 'Multiplica duas matrizes (A·B), respeitando a regra de compatibilidade de dimensões (colunas de A = linhas de B).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Primeira matriz."}, "B": {"description": "Segunda matriz, com número de linhas igual ao de colunas de A."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Produto A·B."}}') WHERE slug = 'produto_matricial';
UPDATE techniques SET how_it_works = 'Calcula a pseudo-inversa de Moore-Penrose, que generaliza a inversa pra matrizes não-quadradas ou singulares — é o que torna possível resolver sistemas de mínimos quadrados (como em OLS/MLR) mesmo quando a matriz não é quadrada.', historical_note = 'Desenvolvida independentemente por Eliakim Moore (1920) e Roger Penrose (1955).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Matriz de entrada, qualquer formato."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"A_pinv": {"description": "Pseudo-inversa de A."}}') WHERE slug = 'pseudo_inversa';
UPDATE techniques SET how_it_works = 'Treina muitas árvores de decisão independentes, cada uma vendo um subconjunto aleatório das amostras e das variáveis, e combina os votos de todas pra decidir a classe final (ou a média, em regressão). A aleatoriedade entre as árvores reduz overfitting comparado a uma árvore única.', historical_note = 'Introduzido por Leo Breiman em 2001, consolidando ideias anteriores de bagging (do próprio Breiman, 1996) com seleção aleatória de variáveis.', usage_tips = 'Não exige normalização dos dados (é invariante a escala) e dá de graça uma medida de importância de variável — pode ser usado tanto como classificador quanto pra entender quais regiões do espectro mais pesam na decisão.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de variáveis preditoras."}, "y": {"description": "Rótulo de classe de cada amostra."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Floresta de árvores treinada."}}') WHERE slug = 'random_forest';
UPDATE techniques SET how_it_works = 'Calcula o posto (rank) de uma matriz — o número de linhas/colunas linearmente independentes. Útil pra saber, por exemplo, quantos componentes PARAFAC/PCA fazem sentido extrair no máximo.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Matriz de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Posto da matriz (número inteiro)."}}') WHERE slug = 'rank';
UPDATE techniques SET how_it_works = 'Reorganiza os dados de um array num novo formato (shape), mantendo o mesmo número total de elementos — ex: transformar um vetor de 100 pontos numa matriz 10×10.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X_reshaped": {"description": "Array com o novo shape especificado."}}') WHERE slug = 'reshape';
UPDATE techniques SET how_it_works = 'Rede neural recorrente (LSTM ou GRU, conforme parâmetro): processa o espectro como uma sequência, mantendo um "estado" interno que carrega informação dos pontos anteriores ao processar cada novo ponto — pensada originalmente pra dados sequenciais no tempo, mas pode ser aplicada a espectros tratando o eixo espectral como uma sequência.', historical_note = 'A arquitetura LSTM foi proposta por Sepp Hochreiter e Jürgen Schmidhuber em 1997, resolvendo o problema de gradientes que desaparecem em RNNs simples; GRU é uma simplificação posterior (Cho et al., 2014).', usage_tips = 'Menos comum que CNN-1D pra dados espectrais puros (que não têm uma noção forte de "ordem temporal"), mas pode valer a pena se os dados tiverem componente temporal real (ex: monitoramento de processo ao longo do tempo).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de sequências (amostras × passos), ex: espectro tratado como sequência, ou série temporal de processo."}, "y": {"description": "Valor a prever ou rótulo de classe."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Rede RNN (LSTM/GRU) treinada."}}') WHERE slug = 'rnn';
UPDATE techniques SET how_it_works = 'Ajusta um polinômio de grau baixo a uma janela deslizante de pontos ao redor de cada ponto do espectro, por mínimos quadrados, e usa esse polinômio pra suavizar o ponto (ordem 0) ou calcular sua derivada (1ª ou 2ª ordem) sem precisar de diferenças finitas brutas, que amplificam ruído.', historical_note = 'Publicado por Abraham Savitzky e Marcel Golay em 1964 — um dos artigos mais citados da química analítica, por resolver de forma elegante o compromisso entre suavizar ruído e preservar a forma dos picos.', usage_tips = 'Derivadas (1ª ou 2ª) removem efeitos de linha de base e sobreposição de picos — muito usado antes de PLS em NIR. Janela maior suaviza mais mas também pode distorcer picos estreitos; comece com janela pequena e aumente só se precisar.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X": {"description": "Espectros suavizados ou derivados (conforme parâmetro `derivative`), mesma dimensão da entrada."}}') WHERE slug = 'savitzky_golay';
UPDATE techniques SET how_it_works = 'Seleciona um subconjunto de amostras (linhas) de um dataset, por índice explícito ou por máscara booleana.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados completa."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X_selected": {"description": "Subconjunto de amostras selecionado."}}') WHERE slug = 'selecao_amostras';
UPDATE techniques SET how_it_works = 'Seleciona um subconjunto de variáveis (colunas) de um dataset, por índice, intervalo ou máscara booleana — diferente das técnicas de seleção de variáveis "inteligentes" da família 11 (VIP, CARS, etc.), aqui a escolha é manual/direta.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados completa."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X_selected": {"description": "Subconjunto de variáveis selecionado."}}') WHERE slug = 'selecao_variaveis';
UPDATE techniques SET how_it_works = 'Constrói um modelo PCA separado pra CADA classe, usando só as amostras daquela classe. Uma amostra nova é testada contra cada modelo de classe (via a distância ao modelo, combinando resíduo Q e T² de Hotelling) — ela pode ser classificada em uma classe, em nenhuma (outlier de todas), ou em mais de uma (classes sobrepostas).', historical_note = 'Proposto por Svante Wold em 1976 (Soft Independent Modelling of Class Analogies) — é o método clássico de "one-class modeling" em quimiometria, anterior e conceitualmente diferente da ideia moderna de One-Class SVM.', usage_tips = 'Precisa de uma PCA rodada antes pra cada classe — normalmente o próprio bloco de SIMCA já faz isso internamente. É a técnica certa quando você quer saber não só "qual classe" mas também "essa amostra sequer pertence a alguma classe que eu conheço".', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X_train": {"description": "Espectros de treino, organizados por classe."}, "y": {"description": "Rótulo de classe de cada amostra de treino."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Conjunto de modelos PCA (um por classe)."}, "class_distances": {"description": "Distância de cada amostra a cada modelo de classe (combinação de Q-residual e T²)."}}') WHERE slug = 'simca';
UPDATE techniques SET how_it_works = 'Seleciona uma parte (sub-região) de um ou mais eixos de um array, por intervalo de índices — ex: recortar só uma faixa de comprimentos de onda.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"A_slice": {"description": "Sub-região selecionada do array original."}}') WHERE slug = 'slice';
UPDATE techniques SET how_it_works = 'Standard Normal Variate: normaliza cada espectro individualmente, subtraindo sua própria média e dividindo pelo seu próprio desvio padrão — linha por linha, não coluna por coluna. Remove efeitos multiplicativos e aditivos de espalhamento de luz (scatter) causados por diferença de tamanho de partícula entre amostras.', historical_note = 'Proposto por R.J. Barnes, M.S. Dhanoa e Susan Lister em 1989, especificamente pra corrigir efeitos de espalhamento em espectros NIR de amostras sólidas/em pó.', usage_tips = 'Quase sempre o primeiro pré-processamento aplicado em espectros NIR de sólidos, antes de qualquer modelagem. Equivalente em efeito ao MSC na maioria dos casos — raramente se usa os dois juntos.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros brutos (amostras × comprimentos de onda)."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X": {"description": "Espectros corrigidos, mesma dimensão da entrada."}}') WHERE slug = 'snv';
UPDATE techniques SET how_it_works = 'Soma elemento a elemento dois arrays de mesmo shape (ou compatíveis por broadcast).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Primeiro array."}, "B": {"description": "Segundo array, de shape compatível."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Resultado de A + B, elemento a elemento."}}') WHERE slug = 'soma';
UPDATE techniques SET how_it_works = 'Divide um array em partes menores ao longo de um eixo, em pontos de corte especificados.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"parts": {"description": "Lista de sub-arrays resultantes da divisão."}}') WHERE slug = 'split';
UPDATE techniques SET how_it_works = 'Remove eixos de tamanho 1 de um array, sem alterar os dados — útil pra limpar dimensões redundantes depois de alguma operação.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X_sq": {"description": "Array sem os eixos de tamanho 1."}}') WHERE slug = 'squeeze';
UPDATE techniques SET how_it_works = 'Empilha vários arrays de mesmo shape ao longo de um novo eixo, criando um array de dimensão maior (ex: empilhar vários espectros 1D numa matriz 2D).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"arrays": {"description": "Lista de arrays de mesmo shape a empilhar."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"stacked": {"description": "Array resultante, com um eixo a mais que os de entrada."}}') WHERE slug = 'stack';
UPDATE techniques SET how_it_works = 'Calcula o desvio padrão dos valores de um array, ao longo do eixo especificado — mede a dispersão dos dados em torno da média.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Desvio padrão calculado."}}') WHERE slug = 'std';
UPDATE techniques SET how_it_works = 'Subtrai elemento a elemento dois arrays de mesmo shape (ou compatíveis por broadcast).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Primeiro array (minuendo)."}, "B": {"description": "Segundo array (subtraendo), de shape compatível."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Resultado de A - B, elemento a elemento."}}') WHERE slug = 'subtracao';
UPDATE techniques SET how_it_works = 'Soma todos os valores de um array, ao longo do eixo especificado.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Soma calculada."}}') WHERE slug = 'sum';
UPDATE techniques SET how_it_works = 'Decompõe qualquer matriz X em três matrizes: U (vetores singulares à esquerda), Σ (valores singulares, em ordem decrescente de importância) e Vᵀ (vetores singulares à direita), de forma que X = U·Σ·Vᵀ. É a operação matemática por trás da PCA — os valores singulares ao quadrado são proporcionais à variância explicada.', historical_note = 'O teorema da decomposição em valores singulares remonta a trabalhos independentes de Eugenio Beltrami e Camille Jordan na década de 1870 — muito antes de qualquer aplicação computacional existir.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Matriz de entrada, qualquer formato (não precisa ser quadrada)."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"U": {"description": "Vetores singulares à esquerda."}, "S": {"description": "Valores singulares, em ordem decrescente."}, "Vt": {"description": "Vetores singulares à direita (transpostos)."}}') WHERE slug = 'svd';
UPDATE techniques SET how_it_works = 'Encontra a fronteira de decisão que maximiza a margem entre classes. Para dados não linearmente separáveis no espaço original, usa um kernel (RBF é o mais comum) que projeta os dados num espaço de dimensão maior onde a separação linear passa a ser possível, sem precisar calcular essa projeção explicitamente ("kernel trick").', historical_note = 'Formalizado por Vladimir Vapnik e Corinna Cortes em 1995, com base na teoria de aprendizado estatístico que Vapnik vinha desenvolvendo desde os anos 1960.', usage_tips = 'Costuma performar bem mesmo com poucas amostras e muitas variáveis (cenário comum em espectroscopia), mas é sensível à escala dos dados — sempre normalize/autoscale antes de treinar.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de variáveis preditoras."}, "y": {"description": "Rótulo de classe de cada amostra."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo SVM treinado (kernel RBF ou linear, conforme parâmetro)."}}') WHERE slug = 'svm';
UPDATE techniques SET how_it_works = 'Calcula o traço de uma matriz quadrada — a soma dos elementos da diagonal principal.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"A": {"description": "Matriz quadrada de entrada."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"result": {"description": "Traço da matriz."}}') WHERE slug = 'trace';
UPDATE techniques SET how_it_works = 'Arquitetura baseada em mecanismo de atenção (self-attention): em vez de processar a sequência ponto a ponto como a RNN, calcula diretamente o quanto cada ponto do espectro "deveria prestar atenção" em cada outro ponto, capturando relações entre regiões distantes do espectro sem precisar de recorrência.', historical_note = 'Introduzido por Vaswani et al. em 2017 ("Attention Is All You Need"), originalmente pra tradução automática — hoje é a base dos grandes modelos de linguagem, e vem sendo adaptado também pra sinais espectrais.', usage_tips = 'É a arquitetura mais pesada em dados/computação do catálogo — só vale a pena com volume considerável de dados de treino; pra datasets pequenos, PLS ou CNN-1D tendem a generalizar melhor.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de espectros (amostras × comprimentos de onda)."}, "y": {"description": "Valor a prever ou rótulo de classe."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo Transformer treinado."}}') WHERE slug = 'transformer';
UPDATE techniques SET how_it_works = 'Transpõe (permuta) os eixos de uma matriz ou tensor N-way — troca linhas por colunas (ou reordena os modos, em tensores).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Array de entrada, qualquer ordem."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X_T": {"description": "Array com os eixos transpostos/permutados."}}') WHERE slug = 'transpose';
UPDATE techniques SET how_it_works = 'Trata valores ausentes (NaN) num dataset — por remoção das amostras/variáveis afetadas ou por preenchimento simples. Pra estratégias mais sofisticadas de imputação, veja a família "Dados Faltantes" (ainda em desenvolvimento nesta versão).', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Matriz de dados com valores ausentes."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X_filled": {"description": "Dados após tratamento dos valores ausentes."}}') WHERE slug = 'tratamento_missing';
UPDATE techniques SET how_it_works = 'Decompõe um tensor de ordem 3 num núcleo (core) menor mais três matrizes de loadings, uma por modo — diferente do PARAFAC, permite um número diferente de componentes por modo e captura interações entre componentes de modos diferentes (via o núcleo), mas em troca não tem solução única.', historical_note = 'Proposto por Ledyard Tucker em 1966, antes mesmo do PARAFAC — é a generalização multiway mais direta da PCA (PCA é um caso particular de Tucker com um modo só).', usage_tips = 'Use em vez de PARAFAC quando não há motivo pra esperar trilinearidade exata nos dados, ou quando quer explorar quantos componentes cada modo realmente precisa de forma independente.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Tensor de ordem ≥ 3."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"core": {"description": "Núcleo da decomposição — interações entre componentes de modos diferentes."}, "loadings": {"description": "Matriz de loadings por modo."}}') WHERE slug = 'tucker3';
UPDATE techniques SET how_it_works = 'Desdobra ("unfold") o tensor de entrada numa matriz 2D (amostras × todas as outras dimensões achatadas em uma só) e roda um PLS comum sobre essa matriz desdobrada — mais simples que N-PLS, mas perde a separação entre os modos originais do tensor.', usage_tips = 'Mais rápido e simples de interpretar que N-PLS quando a estrutura multilinear não é o foco — mas se os diferentes modos do tensor tiverem significado físico distinto que você quer preservar na interpretação do modelo, prefira N-PLS.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Tensor de dados, ordem ≥ 3 — será desdobrado internamente em matriz antes do PLS."}, "y": {"description": "Valor de referência a ser previsto."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"model": {"description": "Modelo PLS treinado sobre os dados desdobrados."}}') WHERE slug = 'u_pls';
UPDATE techniques SET how_it_works = 'Desdobra ("achata") um tensor de ordem superior numa matriz 2D, ao longo de um modo escolhido — passo necessário antes de aplicar qualquer técnica que só aceita entrada 2D (ex: PCA comum) sobre dados originalmente multiway.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"X": {"description": "Tensor de ordem ≥ 3 a ser desdobrado."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"X_unf": {"description": "Matriz 2D resultante do desdobramento ao longo do modo escolhido."}}') WHERE slug = 'unfolding';
UPDATE techniques SET how_it_works = 'Variable Importance in Projection: calcula, pra cada variável de um modelo PLS já treinado, o quanto ela contribuiu pra explicar tanto X quanto y ao longo de todos os componentes do modelo. Variáveis com VIP > 1 (regra prática comum) são consideradas importantes; abaixo disso, candidatas a descarte.', historical_note = 'Formalizado por Svante Wold e colaboradores nos anos 1990 como ferramenta de interpretação/seleção de variáveis específica pra modelos PLS.', usage_tips = 'Precisa de um modelo PLS já treinado como ponto de partida — normalmente usado depois de rodar PLS pra decidir quais regiões do espectro manter num modelo mais enxuto, não como primeiro passo.', input_schema = JSON_MERGE_PATCH(COALESCE(input_schema, '{}'), '{"model": {"description": "Modelo PLS já treinado."}}'), output_schema = JSON_MERGE_PATCH(COALESCE(output_schema, '{}'), '{"vip_scores": {"description": "Score VIP de cada variável — valores > 1 geralmente indicam variável relevante."}}') WHERE slug = 'vip';

